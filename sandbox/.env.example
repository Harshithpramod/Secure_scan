# Copy to `.env` on the VPS and fill in real values.
# Generate strong values with: openssl rand -hex 32

# Bearer token PentestAI presents when submitting jobs to /api/jobs
SANDBOX_API_TOKEN=replace-me

# Shared HMAC secret used to sign job-result callbacks
CALLBACK_HMAC_SECRET=replace-me

# Where the sandbox POSTs job results (a PentestAI /api/public/* route)
PENTESTAI_CALLBACK_URL=https://your-app.example.com/api/public/sandbox-callback

# Public hostname for this sandbox (used by Caddy for TLS). DNS for this host
# must already resolve to the VPS before starting the stack, or Caddy's
# automatic Let's Encrypt certificate request will fail.
SANDBOX_HOSTNAME=sandbox.example.com

# --- "Fix with AI" -----------------------------------------------------------
# Required for fix jobs. Verification still works without it; fix jobs return a
# clear "not configured" verdict instead of failing silently.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model OpenRouter serves. Leave blank to use the built-in default
# (qwen/qwen3-coder). Must be a model that handles long code output well.
FIXER_MODEL=

# How many patches the fixer may try for one finding. Every patch is re-scanned
# (with GEMINI_API_KEY, below) and a PR opens only for one the re-scan passes.
# A rejected patch goes back to the model with what the re-scan found. 1-5;
# blank means 3. Each fix costs 2 scan calls up front plus up to 2 per attempt
# (8 at most with 3 attempts), which matters on the Gemini free tier.
FIX_MAX_ATTEMPTS=

# Browser-facing base URL of your PentestAI deployment, used to add a "view
# this finding" link to the pull request body. Optional — leave blank to omit
# the link. NOTE: this is the URL a *person* opens; the weekly-scan scheduler
# reaches the app via PENTESTAI_CALLBACK_URL's host instead, because in local
# dev "localhost" inside a container means the container itself.
APP_URL=https://your-app.example.com

# --- Repository scanning ---
# Repository scans run in this worker (they used to run inside the app's HTTP
# request, which doesn't fit Cloudflare Workers' limits). Same key as the app's
# GEMINI_API_KEY. Without it, scan jobs return a clear "not configured" verdict.
GEMINI_API_KEY=

# Blank = gemini-2.5-flash.
SCAN_MODEL=

# --- Weekly automated scanning ---
# How often the worker pings the app to check for repositories due for their
# weekly scan (repositories.scan_mode = 'weekly'). This is just ping
# frequency, not the scan interval — that's WEEKLY_SWEEP_INTERVAL_HOURS in the
# APP's own .env, since the app is what decides what's actually due. Blank = 60.
WEEKLY_SWEEP_CHECK_MINUTES=
